<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Vista.MainActivity">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="193dp"
        android:layout_height="41dp"
        android:layout_marginTop="16dp"
        android:text="@string/txtTitulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/txtPaciente"
        android:layout_width="0dp"
        android:layout_height="49dp"
        android:layout_marginTop="32dp"
        android:ems="10"
        android:hint="@string/txtPaciente"
        android:inputType="text"
        android:text=""
        app:layout_constraintEnd_toEndOf="@+id/txtTitulo"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/txtTitulo"
        app:layout_constraintTop_toBottomOf="@+id/txtTitulo" />

    <Button
        android:id="@+id/btnCalcularIMC"
        android:layout_width="246dp"
        android:layout_height="60dp"
        android:layout_marginTop="156dp"
        android:text="@string/btnCalcularIMC"
        app:layout_constraintEnd_toEndOf="@+id/txtPaciente"
        app:layout_constraintHorizontal_bias="0.509"
        app:layout_constraintStart_toStartOf="@+id/txtPaciente"
        app:layout_constraintTop_toBottomOf="@+id/txtPaciente" />

    <EditText
        android:id="@+id/txtPeso"
        android:layout_width="192dp"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:ems="10"
        android:hint="Ingrese su peso"
        android:inputType="text"
        android:text=""
        app:layout_constraintEnd_toEndOf="@+id/txtPaciente"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/txtPaciente"
        app:layout_constraintTop_toBottomOf="@+id/txtPaciente" />

    <EditText
        android:id="@+id/txtEstatura"
        android:layout_width="191dp"
        android:layout_height="45dp"
        android:layout_marginTop="4dp"
        android:ems="10"
        android:hint="Ingrese su altura"
        android:inputType="text"
        android:text=""
        app:layout_constraintEnd_toEndOf="@+id/txtPeso"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/txtPeso"
        app:layout_constraintTop_toBottomOf="@+id/txtPeso" />

    <TextView
        android:id="@+id/txtNombre"
        android:layout_width="199dp"
        android:layout_height="57dp"
        android:layout_marginTop="32dp"
        android:text="Nombre"
        app:layout_constraintEnd_toEndOf="@+id/btnCalcularIMC"
        app:layout_constraintHorizontal_bias="0.425"
        app:layout_constraintStart_toStartOf="@+id/btnCalcularIMC"
        app:layout_constraintTop_toBottomOf="@+id/btnCalcularIMC" />

    <TextView
        android:id="@+id/txtIMC"
        android:layout_width="198dp"
        android:layout_height="58dp"
        android:text="IMC"
        app:layout_constraintEnd_toEndOf="@+id/txtNombre"
        app:layout_constraintStart_toStartOf="@+id/txtNombre"
        app:layout_constraintTop_toBottomOf="@+id/txtNombre" />

    <TextView
        android:id="@+id/txtEstadoSalud"
        android:layout_width="201dp"
        android:layout_height="65dp"
        android:text="Estado de Salud"
        app:layout_constraintEnd_toEndOf="@+id/txtIMC"
        app:layout_constraintStart_toStartOf="@+id/txtIMC"
        app:layout_constraintTop_toBottomOf="@+id/txtIMC" />

</androidx.constraintlayout.widget.ConstraintLayout>